+# The only command interface of this repo. List tasks with `task --list`.
+# Tasks print nothing on success and the full output on failure.
+# To see everything: task --output interleaved <name>
+version: '3'
+
+silent: true
+output:
+  group:
+    error_only: true
+
+includes:
+  init:
+    taskfile: Taskfile.init.yml
+    optional: true
+    flatten: true
+
+tasks:
+  setup:
+    desc: Install git hooks and sync the virtual environment
+    cmds:
+      - lefthook install
+      - uv sync --locked
+
+  dev:
+    desc: Run the program, e.g. `task dev -- version --json`
+    interactive: true
+    cmds:
+      - uv run --locked projectname {{.CLI_ARGS}}
+
+  fmt:
+    desc: Format the code and apply safe lint fixes
+    cmds:
+      # Lint fixes first, then format. Problems that cannot be fixed automatically are reported by `task lint`.
+      - ruff check --fix --exit-zero .
+      - ruff format .
+
+  lint:
+    desc: Check formatting, lint and types
+    cmds:
+      - ruff format --check .
+      - ruff check .
+      - uv sync --locked
+      - pyright
+
+  test:
+    desc: Unit tests and e2e smoke tests (fast, runs on every commit)
+    cmds:
+      - uv run --locked pytest -m "not full"
+
+  e2e:
+    desc: Full e2e suite, including the tests marked @pytest.mark.full
+    cmds:
+      - uv run --locked pytest
+
+  check:
+    desc: lint + types + test. Must pass before every commit
+    cmds:
+      - task: lint
+      - task: test
+
+  build:
+    desc: Build the wheel into dist/
+    cmds:
+      - uv build --wheel
+
+  ci:
+    desc: Everything CI runs (check + e2e + build)
+    cmds:
+      - task: check
+      - task: e2e
+      - task: build
+
+  changelog:
+    desc: Regenerate CHANGELOG.md from the commit history
+    cmds:
+      - git-cliff --output CHANGELOG.md
